<div class="flex flex-col justify-start items-center gap-2">
    <h1>Sign up</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |form| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="flex flex-col justify-start items-center gap-2">
            <%= form.hidden_field :time_zone, value: nil %>

            <div class="field">
                <%= form.label :email %><br>
                <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "border-solid border-1 border-gray-300 rounded-md", placeholder: "johndoe@gmail.com" %>
            </div>

            <div class="field">
                <%= form.label :password %>
                <% if @minimum_password_length %>
                    <em>(<%= @minimum_password_length %> characters minimum)</em>
                <% end %><br>
                <%= form.password_field :password, autocomplete: "new-password", class: "border-solid border-1 border-gray-300 rounded-md", placeholder: "password" %>
            </div>

            <div class="field">
                <%= form.label :password_confirmation %><br>
                <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "border-solid border-1 border-gray-300 rounded-md", placeholder: "Confirm password" %>
            </div>

            <div class="bg-blue-400 rounded-md p-2 text-center text-white">
                <%= form.submit "Sign up" %>
            </div>
        </div>
    <% end %>

    <%= render "devise/shared/links" %>
</div>
