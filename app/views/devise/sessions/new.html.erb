<div class="flex flex-col justify-start items-center gap-2">
    <h1>Log in</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |form| %>
        <div class="flex flex-col justify-start items-center gap-2">
            <div class="field">
                <%= form.label :email %><br>
                <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "border-solid border-1 border-gray-300 rounded-md", placeholder: "johndoe@gmail.com" %>
            </div>

            <div class="field">
                <%= form.label :password %><br>
                <%= form.password_field :password, autocomplete: "current-password", class: "border-solid border-1 border-gray-300 rounded-md", placeholder: "password" %>
            </div>

            <% if devise_mapping.rememberable? %>
                <div class="field">
                    <%= form.check_box :remember_me %>
                    <%= form.label :remember_me %>
                </div>
            <% end %>

            <div class="bg-blue-400 rounded-md p-2 text-center text-white">
                <%= form.submit "Log in" %>
            </div>
        </div>
    <% end %>

    <%= render "devise/shared/links" %>
</div>
