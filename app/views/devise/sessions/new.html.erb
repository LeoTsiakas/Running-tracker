<div class="flex flex-col justify-center items-center gap-2">
    <div class="w-full text-center text-xl font-bold opacity-100 text-white pt-5 pb-4">Log In</div>

    <%= render "devise/shared/google_button" %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |form| %>
        <div class="flex flex-col justify-start items-center gap-2 w-72">
            <div class="w-full flex flex-col items-start gap-2">
                <%= form.label :email %>
                <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-2 border-solid border-1 border-gray-300 rounded-md", placeholder: "johndoe@gmail.com" %>
            </div>

            <div class="w-full flex flex-col items-start gap-2">
                <%= form.label :password %>
                <%= form.password_field :password, autocomplete: "current-password", class: "w-full px-2 border-solid border-1 border-gray-300 rounded-md", placeholder: "password" %>
            </div>

            <% if devise_mapping.rememberable? %>
                <div class="w-full text-left py-1">
                    <%= form.check_box :remember_me %>
                    <%= form.label :remember_me %>
                </div>
            <% end %>

            <%= form.submit "Log in", class: "w-full bg-blue-400 rounded-md p-2 my-1 text-center text-white cursor-pointer" %>
        </div>
    <% end %>

    <%= render "devise/shared/links" %>
</div>
