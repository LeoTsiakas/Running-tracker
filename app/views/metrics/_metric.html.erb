<div class="card flex flex-col justify-between gap-3 p-6 border border-running-tracker-orange shadow-xs overflow-hidden transition-transform transform hover:scale-110">
  <div class="flex justify-between items-center max-w-xl text-sm">
    <label for="date" class="mr-4">Date:</label>
    <span><%= metric.date.strftime("%Y-%m-%d %H:%M") %></span>
  </div>

  <div class="flex justify-between items-center max-w-xl text-sm">
    <label for="time" class="mr-4">Time:</label>
    <span><%= Time.at(metric.time).utc.strftime("%H:%M:%S") %></span>
  </div>

  <div class="flex justify-between items-center max-w-xl text-sm">
    <label for="distance" class="mr-4">Distance:</label>
    <span><%= metric.distance %></span>
  </div>
</div>
