<div class="flex flex-col justify-between gap-3 p-6 bg-white dark:bg-neutral-800 border border-black/10 dark:border-white/10 rounded-xl shadow-xs overflow-hidden transition-transform transform hover:scale-110">
  <div class="flex justify-between items-center max-w-xl text-sm text-neutral-200">
    <label for="date" class="mr-4">Date:</label>
    <span><%= metric.date.strftime("%Y-%m-%d %H:%M") %></span>
  </div>

  <div class="flex justify-between items-center max-w-xl text-sm text-neutral-200">
    <label for="time" class="mr-4">Time:</label>
    <span><%= metric.time %></span>
  </div>

  <div class="flex justify-between items-center max-w-xl text-sm text-neutral-200">
    <label for="distance" class="mr-4">Distance:</label>
    <span><%= metric.distance %></span>
  </div>
</div>