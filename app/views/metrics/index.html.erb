<!-- datarangepicker does not exist in the npm registry, so we are using a CDN instead -->
<script src="https://cdn.jsdelivr.net/gh/alumuko/vanilla-datetimerange-picker@latest/dist/vanilla-datetimerange-picker.js"></script>

<%= form_with url: metrics_path, method: :get do |form| %>
  <div class="flex flex-wrap items-center gap-3">
    <%= form.text_field :selected_date_range,
                        value: params[:selected_date_range],
                        placeholder: "Pick a date range",
                        class: "min-w-64 flex-1 rounded-md border border-gray-300 bg-white px-3 py-2 text-black",
                        data: { controller: "daterangepicker" } %>
    <%= form.submit "Filter",
                    class: "cursor-pointer rounded-md bg-blue-400 px-4 py-2 text-black transition-transform hover:scale-110" %>
  </div>
<% end %>

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 bg-black opacity-80 p-5 mt-5 rounded-md">
  <%= render @metrics %>
</div>

<div data-controller="chart" class="flex flex-col justify-center items-center gap-4 mb-4">
  <button data-action="click->chart#openTimeChart" class="bg-blue-400 p-4 rounded-md text-white hover:scale-110">
    Time
  </button>

  <button data-action="click->chart#openDistanceChart" class="bg-orange-400 p-4 rounded-md text-white hover:scale-110">
    Distance
  </button>

  <div class="bg-white w-full">
    <div data-chart-target="timeChart">
      <%= area_chart build_chart_data(@metrics, :time), xtitle: "Date", ytitle: "Time" %>
    </div>

    <div data-chart-target="distanceChart" class="hidden">
      <%= area_chart build_chart_data(@metrics, :distance), xtitle: "Date", ytitle: "Distance" %>
    </div>
  </div>
</div>
