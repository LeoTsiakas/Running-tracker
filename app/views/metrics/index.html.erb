<!-- datarangepicker does not exist in the npm registry, so we are using a CDN instead -->
<script src="https://cdn.jsdelivr.net/gh/alumuko/vanilla-datetimerange-picker@latest/dist/vanilla-datetimerange-picker.js"></script>

<div class="flex flex-col gap-3 flex-grow justify-center items-center">
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-5">
    <% @metrics.ordered.each do |metric| %>
      <%= link_to metric_path(metric) do %>
        <%= render partial: "metric", locals: { metric: metric } %>
      <% end %>
    <% end %>
  </div>
</div>
