<!DOCTYPE html>
<html>
  <head>
    <%= render "shared/head" %>
  </head>

  <body>
    <%= render partial: "shared/header" %>

    <% if notice.present? %>
      <p class="w-[300px] mx-auto bg-green-400 border-solid border-2 border-green-500 rounded-md p-2 text-center text-black"><%= notice %></p>
    <% end %>

    <% if alert.present? %>
      <p class="w-[300px] mx-auto bg-red-300 border-solid border-2 border-red-400 rounded-md p-2 text-center text-black"><%= alert %></p>
    <% end %>
          
    <%= yield %>
  </body>
</html>
