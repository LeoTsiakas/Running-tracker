<!DOCTYPE html>
<html>
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="font-display bg-running-tracker-blue-900 text-white">
    <%= render partial: "shared/header" %>

    <div class="min-h-screen flex flex-col justify-center items-center">
      <div class="w-full flex flex-col gap-2 items-center p-4">
        <% if notice.present? %>
          <p class="bg-green-400 border-solid border-2 border-green-500 rounded-md p-2 mb-3 text-center text-black"><%= notice %></p>
        <% end %>

        <% if alert.present? %>
          <p class="bg-red-300 border-solid border-2 border-red-400 rounded-md p-2 mb-3 text-center text-black"><%= alert %></p>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
